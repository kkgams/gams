{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAMS",
  "version": "2.2.0",
  "identifier": "com.github.kkgams.gams",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "python3 -m http.server 1420 -d src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "../../../build.nosync/app/icons/32x32.png",
      "../../../build.nosync/app/icons/64x64.png",
      "../../../build.nosync/app/icons/128x128.png",
      "../../../build.nosync/app/icons/128x128@2x.png",
      "../../../build.nosync/app/icons/icon.icns",
      "../../../build.nosync/app/icons/icon.ico"
    ]
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    }
  }
}
